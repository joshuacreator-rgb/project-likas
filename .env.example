# Server
DATABASE_URL=mysql://username:password@host:3306/project_likas
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional platform OAuth. Leave blank to use local email/password sign-in.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
OAUTH_SERVER_URL=

# Optional notification providers. In-app notifications work without these.
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=
RESEND_API_KEY=
EMAIL_FROM=Project Likas <no-reply@example.com>

# Optional integrations
WEATHER_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OWNER_OPEN_ID=
