# ─────────────────────────────────────────────────────────────
#  AttendTrack — Environment Variables Reference
#  Copy this to .env for local dev. Set these in Railway dashboard
#  for staging/production. NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────

# App security — generate a strong random string for production
SECRET_KEY=change-me-to-a-long-random-string

# Database — Railway sets this automatically when you add MySQL/Postgres
# Leave empty to use local SQLite (good for dev/staging)
DATABASE_URL=

# Gmail credentials for absence email notifications
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Optional overrides
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Set to "true" only in local development — never in production
FLASK_DEBUG=false
