# ─────────────────────────────────────────────────────────────
#  Project Likas — Environment Variables Reference
#  Copy this to .env for local dev. Set these in Railway dashboard
#  for staging/production. NEVER commit .env to GitHub.
# ─────────────────────────────────────────────────────────────

# App security — REQUIRED in production. Generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Database — Railway sets this automatically when you add MySQL.
# The app fails fast at startup in production if this is missing.
DATABASE_URL=

# Email (password reset + invitations) via Resend — REQUIRED or those emails are skipped.
# 1. Create an API key at resend.com → API Keys. NEVER commit it.
# 2. Add + verify a sending domain (resend.com → Domains → paste SPF/DKIM DNS records).
#    EMAIL_FROM must use that verified domain, e.g. "Project Likas <noreply@yourdomain.com>".
#    The sandbox sender `onboarding@resend.dev` only delivers to YOUR OWN Resend account email.
# 3. On a Resend trial, also verify each recipient address before it will deliver.
RESEND_API_KEY=
EMAIL_FROM=

# Optional overrides
# PUBLIC_URL=always with https:// scheme, e.g. https://your-app.up.railway.app   (used in emailed links)
# WEATHER_API_KEY=                             (OpenWeather for the weather widget)
# ENABLE_DEMO_LOGIN=true                       (allow /demo login in production — do NOT enable unless you want it)
# NODE_ENV=production

# Manus platform (template auth/storage)
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=